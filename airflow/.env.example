# Copy to airflow/.env (gitignored). Astro loads it into every Airflow container.
#
# The bluesky_pipeline DAG reads Postgres credentials from this connection.
# host.docker.internal reaches the Postgres container through its published port (5433).
# The password must match POSTGRES_PASSWORD in the project root .env.
AIRFLOW_CONN_BLUESKY_POSTGRES='{"conn_type": "postgres", "host": "host.docker.internal", "port": 5433, "login": "haley", "password": "change-me", "schema": "bluesky"}'
